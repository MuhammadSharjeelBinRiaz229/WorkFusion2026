# ==========================================
# WORKFUSION ENV CONFIGURATION EXAMPLE
# Copy this file to .env and configure values
# ==========================================

# Server Configurations
PORT=5000
NODE_ENV=development

# Database Configurations
# Use a local MongoDB instance or MongoDB Atlas Connection string
MONGODB_URI=mongodb://localhost:27017/workfusion

# Authentication Secrets
JWT_SECRET=super_secret_access_token_key_change_in_production
JWT_REFRESH_SECRET=super_secret_refresh_token_key_change_in_production
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Python AI Service URL
# Port 8000 matches our default FastAPI configuration
AI_SERVICE_URL=http://localhost:8000

# Client Configuration (For client side if needed)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
